   "time_basis": "期末",
   "tables": [
    "balance_sheet"
   ],
   "applicable_when": "total_current_liab > 1",
   "reason_if_not": "流动负债为负或在一元以内时不适用",
   "queryable": true
  },
  {
   "name": "debt_ratio",
   "label": "资产负债率",
   "description": "负债合计除以资产总计；0.25 即 25%",
   "expression": "total_liabilities / total_assets",
   "unit": "比率",
   "time_basis": "期末",
   "tables": [
    "balance_sheet"
   ],
   "applicable_when": "total_assets > 1",
   "reason_if_not": "资产总计为负或在一元以内时不适用",
   "queryable": true
  },
  {
   "name": "deduct_ratio",
   "label": "扣非净利润占比",
   "description": "扣非归母净利润除以归母净利润；归母净利润为负或接近零时不适用",
   "expression": "deduct_parent_netprofit / parent_netprofit",
   "unit": "比率",
   "time_basis": "报告期",
   "tables": [
    "income_statement"
   ],
   "applicable_when": "parent_netprofit > 1",
   "reason_if_not": "归母净利润为负或在一元以内时不适用",
   "queryable": true
  },
  {
   "name": "free_cash_flow",
   "label": "自由现金流（简化）",
   "description": "经营现金流净额减购建长期资产支付的现金；未扣租赁本金偿付，对租赁负债大的公司会高估",
   "expression": "netcash_operate - construct_long_asset",
   "unit": "元",
   "time_basis": "年度",
   "tables": [
    "cash_flow"
   ],
   "applicable_when": null,
   "reason_if_not": null,
   "queryable": true
  },
  {
   "name": "gross_margin",
   "label": "毛利率",
   "description": "营业收入减营业成本，除以营业收入；0.25 即 25%",
   "expression": "(operate_income - operate_cost) / operate_income",
   "unit": "比率",
   "time_basis": "报告期",
   "tables": [
    "income_statement"
   ],
   "applicable_when": "operate_income > 1",
   "reason_if_not": "营业收入为负或在一元以内时不适用",
   "queryable": true
  },
  {
   "name": "interest_bearing_debt",
   "label": "有息负债（含租赁）",
   "description": "空值按零计；一年内到期的非流动负债可能含无息部分，是上限口径",
   "expression": "COALESCE(short_loan,0) + COALESCE(noncurrent_liab_1year,0) + COALESCE(long_loan,0) + COALESCE(bond_payable,0) + COALESCE(lease_liab,0)",
   "unit": "元",
   "time_basis": "期末",
   "tables": [
    "balance_sheet"
   ],
   "applicable_when": null,
   "reason_if_not": null,
   "queryable": true
  },
  {
   "name": "invest_income_share",
   "label": "投资收益占营业利润比",
   "description": "投资收益除以营业利润；营业利润为负或接近零时不适用",
   "expression": "invest_income / operate_profit",
   "unit": "比率",
   "time_basis": "报告期",
   "tables": [
    "income_statement"
   ],
   "applicable_when": "operate_profit > 1",
   "reason_if_not": "营业利润为负或在一元以内时不适用",
   "queryable": true
  },
  {
   "name": "net_margin",
   "label": "净利率",
   "description": "净利润除以营业收入；0.25 即 25%",
   "expression": "netprofit / operate_income",
   "unit": "比率",
   "time_basis": "报告期",
   "tables": [
    "income_statement"
   ],
   "applicable_when": "operate_income > 1",
   "reason_if_not": "营业收入为负或在一元以内时不适用",
   "queryable": true
  },
  {
   "name": "ocf_to_netprofit",
   "label": "经营现金流与净利润之比",
   "description": "净利润为负时不适用；2021 年起执行新租赁准则的公司，租金支付计入筹资活动，前后期间不可直接比较",
   "expression": "netcash_operate / income_statement.netprofit",
   "unit": "倍",
   "time_basis": "年度",
   "tables": [
    "cash_flow",
    "income_statement"
   ],
   "applicable_when": "income_statement.netprofit > 1",
   "reason_if_not": "净利润为负或在一元以内时不适用",
   "queryable": true
  },
  {
   "name": "roe_avg",
   "label": "净资产收益率（平均）",
   "description": "简单平均口径，与年报披露的加权平均口径不同；期初期末口径不一致时不适用",
   "expression": "parent_netprofit / ((期初归母权益 + 期末归母权益) / 2)",
   "unit": "比率",
   "time_basis": "年度",
   "tables": [
    "income_statement",
    "balance_sheet"
   ],
   "applicable_when": null,
   "reason_if_not": null,
   "queryable": false
  }
 ],
